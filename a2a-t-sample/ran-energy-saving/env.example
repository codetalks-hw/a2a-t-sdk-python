# Unified configuration of the RAN energy-saving ADK sample.
#
# Copy this file to `a2a-t-sample/ran-energy-saving/.env` (or `a2a-t-sample/.env`) and adjust it.
# The defaults below are a complete offline profile: `offline` runs the scripted SDK LLM provider
# plus the deterministic ADK fake model, so no API key and no network access are needed.
# Every key is read by `shared/config.py`, `run_demo.py`, or the A2A-T SDK itself.

# --- Model mode ---------------------------------------------------------------------------
# `offline`: scripted SDK provider + deterministic ADK fake model (default, no key needed).
# `live`:    the OpenAI-compatible endpoint below is used by both the SDK and the ADK agent.
A2AT_SAMPLE_MODEL_MODE=offline

# --- Process-level language ---------------------------------------------------------------
# `en-US` or `zh-CN`. `run_demo.py --language` writes the same value into registry, server and
# client. The language is not switchable per run and the Web UI only displays it.
A2AT_LANGUAGE=en-US

# --- A2A server bind ----------------------------------------------------------------------
A2AT_SAMPLE_HOST=127.0.0.1
A2AT_SAMPLE_PORT=8000

# --- Mock registry center -----------------------------------------------------------------
# The server registers its AgentCard here and the client discovers it from here.
REGISTRY_CENTER_HOST=127.0.0.1
REGISTRY_CENTER_PORT=5001

# --- Service discovery --------------------------------------------------------------------
# `registry`: query the registry center above.
# `direct`:   read `<A2AT_SAMPLE_DIRECT_SERVER_URL>/.well-known/agent-card.json`.
A2AT_SAMPLE_DISCOVERY=registry
A2AT_SAMPLE_DIRECT_SERVER_URL=http://127.0.0.1:8000

# --- Client event transport ---------------------------------------------------------------
# `sse`: stream `message:stream` responses (default).
# `webhook`: non-blocking send plus the client's embedded push receiver below.
A2AT_SAMPLE_TRANSPORT=sse

# Webhook receiver (used when A2AT_SAMPLE_TRANSPORT=webhook). Port `0` selects an ephemeral port.
A2AT_SAMPLE_WEBHOOK_PORT=9000
# Static demo token; the server must send it in the X-A2A-Notification-Token header.
A2AT_SAMPLE_WEBHOOK_TOKEN=demo-webhook-token
# Backstop: end a webhook phase when no push arrives for this many seconds. It follows the client
# HTTP budget so a webhook phase cannot end before the client gives up (default 300 = HTTP budget).
A2AT_SAMPLE_WEBHOOK_IDLE_TIMEOUT=300

# --- Timeout budgets (live fail-fast) -----------------------------------------------------
# Client HTTP budget of one A2A request. A live-mode server gate performs several SDK LLM calls
# before it sends any event, so the client must wait longer than the server's worst case. The
# default 300s covers the 120s per-call budget across a gate plus ADK agent turns.
A2AT_SAMPLE_HTTP_TIMEOUT_SECONDS=300
# Live LLM budget of one call (SDK structured call or ADK LiteLlm turn) and the SDK's protocol
# retry limit (1..10). The sample writes both values into the per-run SDK .env (overriding
# A2AT_LLM_TIMEOUT_SECONDS / A2AT_LLM_MAX_ATTEMPTS below). The OpenAI transport retries are
# disabled by the traced provider, so one call cannot silently become three attempts; raise the
# timeout further for slower endpoints rather than relying on hidden retries.
A2AT_SAMPLE_LLM_TIMEOUT_SECONDS=120
A2AT_SAMPLE_LLM_MAX_ATTEMPTS=1
# Migration: existing .env files that set A2AT_SAMPLE_WEBHOOK_IDLE_TIMEOUT=30 or
# A2AT_LLM_TIMEOUT_SECONDS=60 should be updated or removed; the new sample keys are
# A2AT_SAMPLE_HTTP_TIMEOUT_SECONDS=300, A2AT_SAMPLE_LLM_TIMEOUT_SECONDS=120 and
# A2AT_SAMPLE_LLM_MAX_ATTEMPTS=1.

# --- Web UI -------------------------------------------------------------------------------
# Default bind host/port of the client Web UI (`run_demo.py --ui`); `--ui-host` / `--ui-port`
# override them. Use 0.0.0.0 to expose the UI on all interfaces (trusted networks only: the demo
# UI has no authentication).
A2AT_SAMPLE_UI_HOST=127.0.0.1
A2AT_SAMPLE_UI_PORT=8080

# --- Run Explorer trace transport (local demo only) ---------------------------------------
# `run_demo.py --ui` sets both keys for the server process automatically: the server POSTs trace
# spans to the Web UI, which accepts them only with the matching per-run token. With neither key
# set (the CLI case) the server writes runs/<runId>/server-trace.jsonl under A2AT_SAMPLE_TRACE_DIR.
# Keep this transport on localhost only: spans carry model prompts, tool arguments and results.
# A2AT_SAMPLE_TRACE_URL=http://127.0.0.1:8080
# A2AT_SAMPLE_TRACE_TOKEN=<random-local-token>
# A2AT_SAMPLE_TRACE_DIR=runs

# --- ADK agent model (live mode) ----------------------------------------------------------
# LiteLlm needs the provider prefix in the model id. The `mass/` prefix is the model id exposed
# by the local OpenAI-compatible proxy; use whatever id your endpoint advertises.
ADK_MODEL_PROVIDER=litellm
ADK_MODEL_NAME=openai/mass/volcengine/deepseek-v4.1-flash
ADK_MODEL_API_BASE=http://127.0.0.1:31943/v1
ADK_MODEL_API_KEY=not-needed

# --- A2A-T SDK LLM (live mode) ------------------------------------------------------------
# The SDK reads its configuration from the .env file passed to A2ATClient / A2ATServer.
# Offline runs override these with the `scripted` provider; in live mode they must point at the
# same OpenAI-compatible endpoint as the ADK model so both sides behave consistently.
A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=mass/volcengine/deepseek-v4.1-flash
A2AT_LLM_API_KEY=not-needed
A2AT_LLM_BASE_URL=http://127.0.0.1:31943/v1
A2AT_LLM_MAX_TOKENS=2000
A2AT_LLM_TEMPERATURE=0
# Source value only: the sample overrides it with A2AT_SAMPLE_LLM_TIMEOUT_SECONDS (120s) and
# A2AT_SAMPLE_LLM_MAX_ATTEMPTS (1) in the per-run SDK .env.
A2AT_LLM_TIMEOUT_SECONDS=60

# Print full LLM request/response payloads (debug only; may expose sensitive content).
A2AT_LLM_DETAIL_LOG_ENABLED=false

# --- Sample debug logging -----------------------------------------------------------------
# `true` prints detailed sample logs (including LLM payloads) to the console.
A2AT_SAMPLE_DEBUG=false
